# The app shell and the version file must always be checked with the server, so a reload is always the latest release.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
# Built files have a content hash in their name: a new release gets new names, so these can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
