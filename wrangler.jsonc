// Cloudflare configuration for 30-All.
// One Worker serves the React app (static assets) and the /api routes,
// and runs an hourly cron job that expires scores pending for 7+ days.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirty-all",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thirty-all-db",
      // Production database (created in the Cloudflare dashboard)
      "database_id": "e9a3eb40-2630-4aef-a496-ebeae0e8afcc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "thirty-all-photos"
    }
  ],
  // The app is served at https://thirtyall.app (Cloudflare creates the DNS record and certificate).
  "routes": [{ "pattern": "thirtyall.app", "custom_domain": true }],
  // Cloudflare Email Service: sends verification codes and notifications from @thirtyall.app.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Keep variables added in the Cloudflare dashboard (e.g. ADMIN_EMAILS) when deploying.
  "keep_vars": true,
  "vars": {
    // "cloudflare" = Cloudflare Email Service, "resend" = Resend (needs RESEND_API_KEY secret),
    // "console" = print emails to the log (used for local development via .dev.vars).
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "30-All <no-reply@thirtyall.app>",
    "APP_URL": "https://thirtyall.app"
    // ADMIN_EMAILS is set in the Cloudflare dashboard (Settings → Variables and Secrets),
    // so personal emails stay out of this public repo.
  }
}
