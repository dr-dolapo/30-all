// Cloudflare configuration for 30-All.
// One Worker serves the React app (static assets) and the /api routes,
// and runs an hourly cron job that expires scores pending for 7+ days.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirty-all",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thirty-all-db",
      // Replace with the id printed by: npx wrangler d1 create thirty-all-db
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "thirty-all-photos"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    // "console" logs emails (local dev). "resend" sends via Resend (needs RESEND_API_KEY secret).
    // "cloudflare" uses Cloudflare Email Service once your account has it (needs the EMAIL binding).
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "30-All <no-reply@example.com>",
    // Comma-separated emails that become admins when they sign up or log in.
    "ADMIN_EMAILS": "",
    "APP_URL": "http://localhost:8787"
  }
}
